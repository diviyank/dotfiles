#### YABAI CONFIG

# for this to work you must configure sudo such that
# it will be able to run the command without password


yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa


yabai -m config layout bsp

yabai -m config top_padding    3
yabai -m config bottom_padding 3
yabai -m config left_padding   3
yabai -m config right_padding  3
yabai -m config window_gap     3

yabai -m config auto_balance off
yabai -m config split_ratio 0.5

yabai -m config mouse_modifier cmd

# set modifier + left-click drag to move window (default: move)
yabai -m config mouse_action1 move

# set modifier + right-click drag to resize window (default: resize)
yabai -m config mouse_action2 resize

yabai -m config focus_follows_mouse autofocus
yabai -m config mouse_follows_focus on


yabai -m config window_shadow float
yabai -m config window_opacity on
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.95


setup_spaces() {
    # `yabai | jq length` exits 0 even when yabai fails, so validate the value.
    # An empty count made $((11 - "")) evaluate to 11, creating 11 spaces on top
    # of the existing 11. That is where 22 spaces came from.
    local current_count
    current_count=$(/opt/homebrew/bin/yabai -m query --spaces | /usr/bin/jq 'length')

    case "$current_count" in
        ''|*[!0-9]*)
            printf 'wm: refusing to create spaces, bad count %s\n' "${current_count:-<empty>}" >&2
            return 1
            ;;
    esac

    # 11 is deliberate: scratchpad_space = 11 in ~/.config/scratchpad/config.toml.
    local target_count=11
    local i="$current_count"
    while [ "$i" -lt "$target_count" ]; do
        /opt/homebrew/bin/yabai -m space --create
        i=$((i + 1))
    done
}

if ! setup_spaces; then
    printf 'wm: setup_spaces refused to run; spaces left as-is\n' >&2
fi

yabai -m space 1 --label one
yabai -m space 2 --label two
yabai -m space 3 --label three
yabai -m space 4 --label four
yabai -m space 5 --label five
yabai -m space 6 --label six
yabai -m space 7 --label seven
yabai -m space 8 --label eight
yabai -m space 9 --label nine
yabai -m space 10 --label ten
yabai -m space 11 --label eleven

yabai -m signal --add event=window_focused action="sketchybar --trigger window_focus"
yabai -m signal --add event=window_created action="sketchybar --trigger windows_on_spaces"
yabai -m signal --add event=window_destroyed action="sketchybar --trigger windows_on_spaces"

# yabai -m signal --add event=window_focused \
#     action="sketchybar --trigger window_attention_changed"

yabai -m signal --add event=window_title_changed \
    action="sketchybar --trigger window_attention_changed"

yabai -m signal --add event=application_activated \
    action="sketchybar --trigger window_attention_changed"

yabai -m signal --add event=application_launched \
    action="sketchybar --trigger window_attention_changed"

# apply-yabai.sh owns external_bar, per-space gaps and the app rules.
# It must run after setup_spaces and the space labels.
#
# EXECUTE it, do not source it. Sourcing would (a) let its `exit 1` abort the
# rest of .yabairc, (b) leak its `set -u`, and (c) break its $0-derived WM_DIR.
if ! "$HOME/.config/wm/apply-yabai.sh"; then
    printf 'wm: apply-yabai.sh FAILED -- external_bar, gaps and app rules are NOT applied\n' >&2
fi

# display_changed is NOT a hotplug event: it fires whenever focus moves between
# displays. Hooking a reload to it would rebuild the bar on every cmd+right.
yabai -m signal --add event=display_added \
    action="$HOME/.config/wm/on-display-change.sh"
yabai -m signal --add event=display_removed \
    action="$HOME/.config/wm/on-display-change.sh"
yabai -m signal --add event=display_moved \
    action="$HOME/.config/wm/on-display-change.sh"
yabai -m signal --add event=display_resized \
    action="$HOME/.config/wm/on-display-change.sh"
