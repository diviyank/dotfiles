#!/bin/sh
# celestia-wallpaper <file> | --reapply | --recolour | --current
PATH="$PATH:/opt/homebrew/bin:$HOME/.cargo/bin:$HOME/.local/bin"
STATE="${CELESTIA_STATE_DIR:-$HOME/.local/state/celestia}"

set_on_every_desktop() {
    escaped="$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    osascript -e "tell application \"System Events\" to tell every desktop to set picture to POSIX file \"$escaped\""
}

scheme_field() { # key default
    value="$(plutil -extract "$1" raw -o - "$STATE/scheme.json" 2>/dev/null)" || value=""
    printf '%s' "${value:-$2}"
}

recolour() {
    seed="$(scheme_field seed '')"
    if [ -n "$seed" ]; then set -- color hex "$seed"; else set -- image "$STATE/source.jpg"; fi
    if ! matugen "$@" -t "$(scheme_field variant scheme-tonal-spot)" -m "$(scheme_field mode dark)" \
        -c "$HOME/.config/celestia/matugen.toml"; then
        echo "celestia-wallpaper: matugen failed" >&2
        exit 1
    fi
}

case "${1:-}" in
    --current)
        [ -s "$STATE/wallpaper" ] || exit 1
        cat "$STATE/wallpaper"
        ;;
    --reapply)
        [ -s "$STATE/wallpaper" ] || exit 0
        set_on_every_desktop "$(cat "$STATE/wallpaper")"
        ;;
    --recolour)
        if [ -z "$(scheme_field seed '')" ] && [ ! -e "$STATE/source.jpg" ]; then
            echo "celestia-wallpaper: no wallpaper set" >&2
            exit 1
        fi
        recolour
        ;;
    "")
        echo "usage: celestia-wallpaper <file> | --reapply | --recolour | --current" >&2
        exit 2
        ;;
    *)
        case "$1" in
            /*) path="$1" ;;
            *) path="$PWD/$1" ;;
        esac
        if [ ! -f "$path" ]; then
            echo "celestia-wallpaper: no such file: $path" >&2
            exit 1
        fi
        set_on_every_desktop "$path" || { echo "celestia-wallpaper: osascript failed" >&2; exit 1; }
        mkdir -p "$STATE"
        printf '%s\n' "$path" > "$STATE/wallpaper"
        if ! sips -s format jpeg -Z 1024 "$path" --out "$STATE/source.jpg" >/dev/null; then
            echo "celestia-wallpaper: sips failed" >&2
            exit 1
        fi
        recolour
        ;;
esac
