
# RELOAD CONFIG
ctrl + alt + cmd - r : launchctl kickstart -k "gui/${UID}/com.koekeishiya.yabai"

# CHANGE LAYOUT (Fixed path for jq and yabai)
ctrl + shift - space : /opt/homebrew/bin/yabai -m space --layout "$(/opt/homebrew/bin/yabai -m query --spaces --space | /opt/homebrew/bin/jq -r 'if .type == "bsp" then "stack" else "bsp" end')"

# FOCUS WINDOW, falling through to the display at the edge.
cmd - up    : $HOME/.config/wm/focus-direction.sh north
cmd - left  : $HOME/.config/wm/focus-direction.sh west
cmd - right : $HOME/.config/wm/focus-direction.sh east
cmd - down  : $HOME/.config/wm/focus-direction.sh south

# FOCUS SPACES (Using Keycodes 0x12-0x1D to ensure it works on AZERTY/QWERTY)
cmd - 0x12 : /opt/homebrew/bin/yabai -m space --focus one
cmd - 0x13 : /opt/homebrew/bin/yabai -m space --focus two
cmd - 0x14 : /opt/homebrew/bin/yabai -m space --focus three
cmd - 0x15 : /opt/homebrew/bin/yabai -m space --focus four
cmd - 0x17 : /opt/homebrew/bin/yabai -m space --focus five
cmd - 0x16 : /opt/homebrew/bin/yabai -m space --focus six
cmd - 0x1A : /opt/homebrew/bin/yabai -m space --focus seven
cmd - 0x1C : /opt/homebrew/bin/yabai -m space --focus eight
cmd - 0x19 : /opt/homebrew/bin/yabai -m space --focus nine
cmd - 0x1D : /opt/homebrew/bin/yabai -m space --focus ten

# MOVE WINDOW TO SPACE
cmd + shift - 0x12 : /opt/homebrew/bin/yabai -m window --space one
cmd + shift - 0x13 : /opt/homebrew/bin/yabai -m window --space two
cmd + shift - 0x14 : /opt/homebrew/bin/yabai -m window --space three
cmd + shift - 0x15 : /opt/homebrew/bin/yabai -m window --space four
cmd + shift - 0x17 : /opt/homebrew/bin/yabai -m window --space five
cmd + shift - 0x16 : /opt/homebrew/bin/yabai -m window --space six
cmd + shift - 0x1A : /opt/homebrew/bin/yabai -m window --space seven
cmd + shift - 0x1C : /opt/homebrew/bin/yabai -m window --space eight
cmd + shift - 0x19 : /opt/homebrew/bin/yabai -m window --space nine
cmd + shift - 0x1D : /opt/homebrew/bin/yabai -m window --space ten

# FULLSCREEN
ctrl - f : /opt/homebrew/bin/yabai -m window --toggle zoom-fullscreen

# MOVE WINDOW TO DISPLAY, and follow it.
cmd + shift + ctrl - left  : $HOME/.config/wm/move-to-display.sh west
cmd + shift + ctrl - right : $HOME/.config/wm/move-to-display.sh east

# TERMINAL
cmd - return : open -na /Applications/kitty.app/Contents/MacOS/kitty
# Toggle Scratchpad
cmd - tab : scratchpad --toggle kitty
# cmd - tab : ~/.config/yabai/scripts/scratchpad.sh
